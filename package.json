{
  "name": "videolov",
  "version": "1.2.0",
  "description": "ВидеоЛов — загрузчик видео и поиск потоков для Windows",
  "main": "app/main.js",
  "author": "M0904sha",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "tools": "node scripts/tools.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "extract-zip": "^2.0.1",
    "playwright": "^1.58.0"
  },
  "build": {
    "appId": "io.github.m0904sha.videolov",
    "productName": "ВидеоЛов",
    "executableName": "VideoLov",
    "copyright": "Copyright © 2026 M0904sha",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ВидеоЛов",
      "artifactName": "VideoLov-Setup-${version}.exe",
      "include": "scripts/installer.nsh"
    }
  }
}
